/ Like button + count for an article. Targeted by class (not id) so multiple
/ instances on a page (e.g. top and bottom of the reader) all update together
/ via turbo_stream.replace_all in LikesController.
.like-button.flex-row.align-center.gap-xs class="like-button-#{article.id}"
  - if logged_in?
    - if article.liked_by?(current_user)
      = button_to article_like_path(article), method: :delete, class: "like-control liked", form: { data: { turbo: true } } do
        span.like-icon ♥
        span.like-count = article.likes_count
    - else
      = button_to article_like_path(article), method: :post, class: "like-control", form: { data: { turbo: true } } do
        span.like-icon ♡
        span.like-count = article.likes_count
  - else
    span.like-control.disabled
      span.like-icon ♥
      span.like-count = article.likes_count
