#!/bin/sh
set -e

# Build, push, and redeploy the Fedify ActivityPub sidecar accessory.
#
# Kamal does NOT build the sidecar image (the `fedify` accessory has no `build:`
# section — it references the prebuilt image pessiv/metazine-fedify), so we build
# and push it ourselves, then reboot the accessory to pull the new image.
#
# Usage: script/deploy-fedify <destination>
#   e.g. script/deploy-fedify pessi
#
# IMPORTANT: Deploy the Rails app first (`bin/deploy -d <destination>`) whenever a
# migration changes columns the sidecar reads (e.g. articles.federated_content).
# The new sidecar queries those columns and will error if they don't exist yet.

IMAGE="pessiv/metazine-fedify:latest"
PLATFORM="linux/amd64"   # matches builder.arch in config/deploy.yml

# Run from the repo root regardless of where the script is invoked.
cd "$(dirname "$0")/.."

DEST="$1"
if [ -z "$DEST" ]; then
  echo "Usage: script/deploy-fedify <destination>" >&2
  echo "Available destinations:" >&2
  ls config/deploy.*.yml 2>/dev/null | sed 's#config/deploy\.##; s#\.yml##; s#^#  - #' >&2
  exit 1
fi

if [ ! -f "config/deploy.$DEST.yml" ]; then
  echo "Unknown destination '$DEST' (no config/deploy.$DEST.yml)" >&2
  exit 1
fi

# Ensure the SSH key is loaded so Kamal can reach the host non-interactively.
ssh-add -l 2>/dev/null | grep -q "id_ed25519" || ssh-add ~/.ssh/id_ed25519

echo "==> Logging into the container registry"
bin/kamal registry login -d "$DEST"

echo "==> Building and pushing $IMAGE ($PLATFORM) from ./fedify"
docker buildx build --platform "$PLATFORM" -t "$IMAGE" --push fedify

echo "==> Rebooting the fedify accessory on '$DEST'"
bin/kamal accessory reboot fedify -d "$DEST"

echo "==> Done. Fedify sidecar redeployed to '$DEST'."
